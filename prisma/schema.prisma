// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  clerkId     String       @id
  email       String       @unique
  username    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  posts       Post[]
  comments    Comment[]
  likes       Like[]
  bookmarks   Bookmark[]
  viewedPosts ViewedPost[]
}

model Post {
  id          String       @id @default(uuid())
  title       String
  text        String
  user        User         @relation(fields: [userClerkId], references: [clerkId], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userClerkId String
  likes       Like[]       @relation(fields: [], references: [])
  comments    Comment[]
  bookmarks   Bookmark[]
  viewedPosts ViewedPost[]
}

model Like {
  post        Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  user        User   @relation(fields: [userClerkId], references: [clerkId], onDelete: Cascade)
  userClerkId String

  @@id([userClerkId, postId])
}

model Comment {
  id          String   @id @default(uuid())
  text        String
  user        User     @relation(fields: [userClerkId], references: [clerkId])
  userClerkId String
  post        Post     @relation(fields: [postId], references: [id])
  postId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bookmark {
  postId      String
  post        Post     @relation(fields: [postId], references: [id])
  user        User     @relation(fields: [userClerkId], references: [clerkId])
  userClerkId String
  createdAt   DateTime @default(now())

  @@id([userClerkId, postId])
}

model ViewedPost {
  postId      String
  post        Post     @relation(fields: [postId], references: [id])
  user        User     @relation(fields: [userClerkId], references: [clerkId])
  userClerkId String
  createdAt   DateTime @default(now())

  @@id([userClerkId, postId])
}
